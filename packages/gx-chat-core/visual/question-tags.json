{
  "radius": 6,
  "paddingX": 5,
  "borderWidth": 1,
  "iconSize": 12,
  "gap": 3,
  "states": {
    "open": {
      "dark": { "text": "#fdba74", "border": "#fb923c", "borderAlpha": 0.55 },
      "light": { "text": "#c2410c", "border": "#ea580c", "borderAlpha": 0.5 }
    },
    "answered": {
      "dark": { "text": "#86efac", "border": "#4ade80", "borderAlpha": 0.4 },
      "light": { "text": "#15803d", "border": "#16a34a", "borderAlpha": 0.45 }
    },
    "withdrawn": {
      "dark": { "text": "#8a8a8a", "border": "#ffffff", "borderAlpha": 0.16 },
      "light": { "text": "#71717a", "border": "#000000", "borderAlpha": 0.16 }
    }
  },
  "hover": {
    "dark": { "color": "#ffffff", "alpha": 0.05 },
    "light": { "color": "#000000", "alpha": 0.04 }
  }
}
